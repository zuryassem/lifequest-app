# Déjalas vacías para usar el modo local de desarrollo (datos sólo en el navegador).
# Con ambas definidas, la app usa Supabase. La clave "anon" es pública por diseño:
# la seguridad la dan las políticas RLS y las funciones SQL de supabase/migrations.
# NUNCA pongas aquí la clave service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sólo para `npm run verify:supabase`: un correo tuyo; se crean cuentas desechables con +lqsmoke… y se borran al terminar.
SMOKE_EMAIL=
